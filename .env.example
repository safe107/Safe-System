# Copy to .env. Local-only values: replace all passwords, never commit real secrets.
DATABASE_URL=jdbc:postgresql://localhost:5432/safe
DATABASE_USERNAME=safe
DATABASE_PASSWORD=choose-a-local-database-password
ADMIN_USERNAME=
ADMIN_PASSWORD=
SAFE_PRODUCTION=false
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
STORAGE_MODE=local
STORAGE_ROOT=./.local/files
# Production: S3 private bucket, server-side credentials only
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
GITHUB_TOKEN=
# Front-end public build variables (no credentials)
VITE_API_URL=
VITE_SITE_URL=
# For optional public prerender build
PRERENDER_API_URL=http://localhost:8080
